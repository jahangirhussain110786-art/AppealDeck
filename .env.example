# Environment variable names (values live in deployment-env stores only — never in the repo)
# Supabase Edge Functions secrets + GitHub Actions secrets + Cloudflare env hold the real values.

# --- Hosts (single app, host-routed via middleware) ---
NEXT_PUBLIC_SITE_URL=https://appealdeck.com
NEXT_PUBLIC_MARKETING_HOST=appealdeck.com
NEXT_PUBLIC_APP_HOST=app.appealdeck.com
NEXT_PUBLIC_APP_URL=https://app.appealdeck.com

# --- Merchant of record (primary: Paddle) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_PRICE_APPEAL_PASS=
NEXT_PUBLIC_PADDLE_PRICE_GUARDIAN_SUB=
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# --- Warm fallback: Polar (verify Pakistan payout at signup) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRICE_APPEAL_PASS=

# --- Active rail switch ---
PAYMENTS_PROVIDER=paddle

# --- Cloud LLM (Gemini, backend only; key NEVER shipped to client bundle) ---
# Get your key at https://aistudio.google.com/app/apikey (free tier is fine for the
# first 20 clients; the breaker in src/lib/breaker.ts caps daily request volume
# to stay under the free-tier RPM/RPD ceiling — see breakerOptions in
# src/lib/llm/gemini.ts).
# Verified working on a new key 4 Sep 2026 (returned 200 OK to a real
# generateContent call). Verified NOT working: gemini-2.5-flash and
# gemini-2.5-flash-lite both 404 on new keys ("no longer available to new
# users"). gemini-flash-latest 503s under load (pro model, no free tier).
# Safe free-tier choices: gemini-3.5-flash (10 RPM, ~250-1500 RPD depending
# on Google's daily rebalance), gemini-3.5-flash-lite (15 RPM, 1k RPD,
# lighter reasoning), gemini-flash-lite-latest (latest alias of the lite).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Supabase (fresh project — never fogvzjtxbqgfppdrxqra) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_DUMP_ENCRYPTION_KEY=

# --- Rate limiting (Upstash Redis, free tier = 10k req/day, 1 region) ---
# Both routes no-op when unset; dev/CI never need this.
# Sign up at https://upstash.com (free) and create a global Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (Plausible or Umami) ---
ANALYTICS_SCRIPT_SRC=
ANALYTICS_HOST=

# --- MCP: GitHub ---
GITHUB_TOKEN=

# --- MCP: Browser-Use (local, needs your own LLM key) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- MCP: Cal.com ---
CAL_API_KEY=

# --- MCP: Playwright ---
# No API key required; uses local Playwright browsers

# --- MCP: Vercel ---
VERCEL_API_KEY=

# --- MCP: Supabase ---
SUPABASE_ACCESS_TOKEN=

# --- MCP: Postgres ---
DATABASE_URL=

# --- MCP: Sentry ---
SENTRY_ACCESS_TOKEN=
EMBEDDED_AGENT_PROVIDER=openai
OPENAI_API_KEY=

# --- MCP: PostHog ---
POSTHOG_API_KEY=

# --- MCP: Refactor ---
# No API key required

# --- MCP: Mem0 ---
MEM0_API_KEY=

# --- MCP: Email (IMAP + SMTP) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# --- Local dev only (never set in deployment env) ---
# Created by `node scripts/seed-dev-user.mjs` on the dev Supabase project.
# Email defaults to dev@appealdeck.com; password is generated randomly and
# printed to stdout. Founder should store the password in a local password
# manager, not commit it.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
