# Environment variable names (values live in deployment-env stores only — never in the repo)
# Supabase Edge Functions secrets + GitHub Actions secrets + Cloudflare env hold the real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://appealdeck.app

# --- Merchant of record (primary: Paddle) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_APPEAL_PASS=
PADDLE_PRICE_GUARDIAN_SUB=
PADDLE_ENV=sandbox

# --- Warm fallback: Polar (verify Pakistan payout at signup) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRICE_APPEAL_PASS=

# --- Active rail switch ---
PAYMENTS_PROVIDER=paddle

# --- Cloud LLM (Gemini paid tier, backend only; free tier = dev fixtures only) ---
GEMINI_DEV_API_KEY=
GEMINI_PROD_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (fresh project — never fogvzjtxbqgfppdrxqra) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_DUMP_ENCRYPTION_KEY=

# --- Analytics (Plausible or Umami) ---
ANALYTICS_SCRIPT_SRC=
ANALYTICS_HOST=
